// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------

enum Role {
  ADMIN
  CONFIRMATION_AGENT
  PACKER
  TRACKING_AGENT
}

enum LeadStatus {
  NEW
  AI_CHATTING
  CONFIRMED
  PACKING
  CANCELED
  DUPLICATE
}

enum ShipmentStatus {
  READY_FOR_PICKUP     // Prêt pour ramassage
  IN_TRANSIT           // Ramassé / En cours de transfert
  OUT_FOR_DELIVERY     // En cours de livraison (avec le livreur)
  DELIVERY_FAILED      // Échec de livraison (Injoignable, reporté, refusé)
  DELIVERED_PAID       // Livré et argent COD encaissé
  RETURNED             // Retourné au stock
}

enum RescueStatus {
  NONE
  NEEDS_ATTENTION      // Détecté en échec de livraison (Injoignable / Reporté / Adresse)
  OUTREACH_SENT        // Message WhatsApp d'assistance envoyé
  RESCHEDULED          // Nouvelle date / créneau convenu avec le client
  ADDRESS_UPDATED      // Adresse ou position GPS actualisée
  ESCALATED            // Transféré manuellement à un agent
  RETURN_CONFIRMED     // Confirmation de retour définitif
}

enum InteractiveMessageType {
  TEXT
  CONFIRMATION_BUTTONS
  LOCATION_REQUEST
  UPSELL_CARD
  MEDIA_SHOWCASE
  RESCUE_PROMPT
  REVIEW_INVITE
}

enum CallResult {
  NO_ANSWER_1
  NO_ANSWER_2
  OUT_OF_COVERAGE
  CALLBACK_REQUESTED
  BUSY
  CONFIRMED_MANUALLY
  CANCELED_BY_CLIENT
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  BLACK_LISTED
}

enum SenderType {
  CUSTOMER
  AI_BOT
  AGENT
}

enum ChannelType {
  WHATSAPP
  CALL
  STOREFRONT_WEBHOOK
  MANUAL
}

// -------------------------------------------------------------
// MODELS
// -------------------------------------------------------------

model User {
  id            String       @id @default(uuid())
  name          String
  email         String       @unique
  passwordHash  String
  role          Role         @default(CONFIRMATION_AGENT)
  isActive      Boolean      @default(true)
  assignedLeads OrderLead[]  @relation("AssignedLeads")
  callLogs      CallLog[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@map("users")
}

model Product {
  id             String       @id @default(uuid())
  name           String
  sku            String       @unique
  basePrice      Float        // Selling price in MAD
  costPrice      Float        // Cost of Goods Sold in MAD
  stockQuantity  Int          @default(0)
  attributes     Json         // e.g. { "colors": ["Noir", "Blanc"], "sizes": ["M", "L", "XL"] }
  knowledgeBase  String       @db.Text // Darija/FR FAQs, selling points, objection handling for AI
  
  // Pillar 3: Product AI Knowledge Base & Upselling
  sellingPoints  String[]     @default([]) // Points forts et arguments clés
  objectionFaqs  Json?        // Objections courantes (prix, qualité, garantie) et réponses
  upsellBundles  Json?        // Offres groupées (ex: 2ème pièce -30%, pack duo)
  mediaGallery   Json?        // Galerie média { type: 'image'|'video', url: string, caption: string }[]
  
  orderItems     OrderItem[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("products")
}

model OrderLead {
  id                   String            @id @default(uuid())
  orderNumber          String            @unique // e.g. "MA-10492"
  customerName         String
  phoneNumber          String            // Moroccan formatted phone (e.g. "0661234567" or "+212661234567")
  altPhoneNumber       String?
  city                 String
  address              String
  gpsLocationUrl       String?           // Google Maps pin from WhatsApp Location message
  preferredDeliveryTime String?          // Créneau horaire souhaité (Matinée / Après-midi)
  totalAmount          Float             // Total COD to collect in MAD
  discountAmount       Float             @default(0.0)
  status               LeadStatus        @default(NEW)
  riskScore            Int               @default(0) // 0-100 risk scoring
  riskLevel            RiskLevel         @default(LOW)
  duplicateOfId        String?
  duplicateOf          OrderLead?        @relation("Duplicates", fields: [duplicateOfId], references: [id])
  duplicateLeads       OrderLead[]       @relation("Duplicates")
  
  // Pillar 1: AI Confirmation & Upselling
  aiConfirmationStatus String            @default("PENDING") // PENDING, CONFIRMED, MODIFIED, CANCELLED, ESCALATED
  upsellOffered        Boolean           @default(false)
  upsellAccepted       Boolean           @default(false)
  upsellDetails        Json?             // { originalQty, newQty, extraPrice, discountPercent }

  // Pillar 2: Needs Attention & Rescue Engine
  rescueStatus         RescueStatus      @default(NONE)
  rescueNotes          String?           @db.Text

  // Pillar 4: Reviews & Customer Feedback
  reviewRating         Int?              // 1 à 5 étoiles
  reviewComment        String?           @db.Text
  reviewTags           String[]          @default([])
  reviewSubmittedAt    DateTime?
  
  // AI Automation & Handover flags
  aiConversationEnabled Boolean          @default(true)
  aiHandoverRequired    Boolean          @default(false)
  aiHandoverReason      String?
  assignedToAgentId     String?
  assignedUser          User?            @relation("AssignedLeads", fields: [assignedToAgentId], references: [id])

  // Relations
  items                OrderItem[]
  shipmentDetail       ShipmentDetail?
  whatsAppMessages     WhatsAppMessage[]
  callLogs             CallLog[]
  timelineEvents       OrderTimeline[]

  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@index([phoneNumber])
  @@index([status])
  @@index([city])
  @@index([rescueStatus])
  @@map("order_leads")
}

model OrderItem {
  id                 String     @id @default(uuid())
  orderId            String
  order              OrderLead  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId          String
  product            Product    @relation(fields: [productId], references: [id])
  quantity           Int        @default(1)
  price              Float      // Unit price at sale time
  selectedAttributes Json?      // e.g. { "size": "XL", "color": "Noir" }

  createdAt          DateTime   @default(now())

  @@map("order_items")
}

model ShipmentDetail {
  id                    String          @id @default(uuid())
  orderId               String          @unique
  order                 OrderLead       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  carrier               String          @default("Sendit.ma")
  senditTrackingNumber  String?         @unique // Sendit Barcode / Parcel ID
  senditPickupId        String?         // Sendit Ramassage batch ID
  status                ShipmentStatus  @default(READY_FOR_PICKUP)
  waybillUrl            String?         // Printable PDF AWB link from Sendit
  
  shippingFee           Float           @default(35.0) // Agreed carrier fee in MAD
  codAmountCollected    Float           @default(0.0)  // Amount actually collected by driver
  isCodReconciled       Boolean         @default(false)// Matched against Sendit payout statement
  codPayoutReference    String?         // Sendit payment batch / transfer ref
  
  // Pillar 2: Delivery Failure & Rescue Tracking
  failedReason          String?         // e.g. "Client Injoignable", "Refusé", "Numéro erroné"
  failureCategory       String?         // "UNREACHABLE", "POSTPONED", "WRONG_ADDRESS", "REFUSED"
  deliveryAttemptsCount Int             @default(0)
  rescueAttemptCount    Int             @default(0)
  lastRescueOutreachAt  DateTime?
  lastStatusUpdateAt    DateTime        @default(now())
  
  // Pillar 4: Interactive Tracking & Notifications
  dispatchNoticeSent    Boolean         @default(false) // WhatsApp départ en livraison avec lien de tracking
  dispatchNoticeSentAt  DateTime?
  morningReminderSent   Boolean         @default(false) // WhatsApp rappel matin avec montant exact COD
  morningReminderSentAt DateTime?
  reviewPromptSent      Boolean         @default(false) // WhatsApp remerciement & lien avis
  reviewPromptSentAt    DateTime?
  deliveryProofUrl      String?         // Preuve de livraison (photo / signature)
  
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([senditTrackingNumber])
  @@index([status])
  @@map("shipment_details")
}

model WhatsAppMessage {
  id                   String                 @id @default(uuid())
  orderId              String
  order                OrderLead              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sender               SenderType
  body                 String                 @db.Text
  audioTranscribedText String?                @db.Text
  audioUrl             String?
  messageType          String                 @default("text") // "text", "audio", "location", "interactive", "media"
  interactiveType      InteractiveMessageType @default(TEXT)
  buttonPayload        String?                // e.g. "CONFIRM_ORDER", "MODIFY_ORDER", "ADD_UPSELL_1", "RETRY_TOMORROW"
  quickReplyOptions    Json?                  // Boutons interactifs ou options rapides
  mediaUrl             String?                // Photo / Vidéo du produit
  externalMessageId    String?                // WhatsApp message id from Evolution / Meta Cloud API
  deliveryStatus       String?                // "sent", "delivered", "read", "failed"
  timestamp            DateTime               @default(now())

  @@index([orderId])
  @@map("whatsapp_messages")
}

model CallLog {
  id        String     @id @default(uuid())
  orderId   String
  order     OrderLead  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id])
  result    CallResult
  notes     String?    @db.Text
  createdAt DateTime   @default(now())

  @@index([orderId])
  @@map("call_logs")
}

model OrderTimeline {
  id        String     @id @default(uuid())
  orderId   String
  order     OrderLead  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  action    String     // e.g. "ORDER_CREATED", "AI_CONFIRMED", "SENDIT_DISPATCHED", "DELIVERY_ATTEMPT_FAILED", "RESCUE_OUTREACH"
  title     String
  details   String?    @db.Text
  actor     String     // "SYSTEM", "AI_AGENT", "SENDIT_WEBHOOK", "USER:john"
  createdAt DateTime   @default(now())

  @@index([orderId])
  @@map("order_timelines")
}
