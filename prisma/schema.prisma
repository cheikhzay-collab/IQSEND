generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            String      @id @db.VarChar(36)
  name          String      @db.VarChar(255)
  email         String      @unique(map: "email") @db.VarChar(255)
  password_hash String      @db.VarChar(255)
  role          users_role? @default(CONFIRMATION_AGENT)
  phone         String?     @db.VarChar(50)
  avatar_url    String?     @db.Text
  is_active     Boolean?    @default(true)
  created_at    DateTime?   @default(now()) @db.Timestamp(0)
  updated_at    DateTime?   @default(now()) @db.Timestamp(0)

  @@map("users")
}

model Product {
  id               String             @id @default(uuid()) @db.VarChar(36)
  name             String             @db.VarChar(255)
  name_ar          String             @db.VarChar(255)
  sku              String             @unique(map: "sku") @db.VarChar(100)
  base_price       Decimal            @db.Decimal(10, 2)
  cost_price       Decimal            @db.Decimal(10, 2)
  stock_quantity   Int?               @default(0)
  category         String?            @default("General") @db.VarChar(100)
  image_url        String?            @db.Text
  attributes       String?            @db.LongText
  description_ar   String?            @db.Text
  knowledge_base   String?            @db.Text
  selling_points   String?            @db.LongText
  objection_faqs   String?            @db.LongText
  upsell_bundles   String?            @db.LongText
  is_active        Boolean?           @default(true)
  created_at       DateTime?          @default(now()) @db.Timestamp(0)
  updated_at       DateTime?          @default(now()) @db.Timestamp(0)
  product_variants product_variants[]
  stock_movements  stock_movements[]

  @@index([category], map: "idx_prod_cat")
  @@index([sku], map: "idx_prod_sku")
  @@map("products")
}

model OrderLead {
  id                      String                     @id @default(uuid()) @db.VarChar(36)
  order_number            String                     @unique(map: "order_number") @db.VarChar(100)
  customer_id             String?                    @db.VarChar(36)
  customer_name           String                     @db.VarChar(255)
  phone_number            String                     @db.VarChar(50)
  alt_phone_number        String?                    @db.VarChar(50)
  city                    String                     @db.VarChar(100)
  address                 String                     @db.Text
  gps_location_url        String?                    @db.Text
  preferred_delivery_time String?                    @db.VarChar(100)
  total_amount            Decimal                    @db.Decimal(10, 2)
  discount_amount         Decimal?                   @default(0.00) @db.Decimal(10, 2)
  status                  order_leads_status?        @default(NEW)
  risk_score              Int?                       @default(0)
  risk_level              order_leads_risk_level?    @default(LOW)
  ai_confirmation_status  String?                    @default("PENDING") @db.VarChar(50)
  upsell_offered          Boolean?                   @default(false)
  upsell_accepted         Boolean?                   @default(false)
  upsell_details          String?                    @db.LongText
  rescue_status           order_leads_rescue_status? @default(NONE)
  rescue_notes            String?                    @db.Text
  review_rating           Int?
  review_comment          String?                    @db.Text
  review_tags             String?                    @db.LongText
  ai_conversation_enabled Boolean?                   @default(true)
  ai_handover_required    Boolean?                   @default(false)
  ai_handover_reason      String?                    @db.VarChar(255)
  assigned_to_agent_id    String?                    @db.VarChar(36)
  store_source            String?                    @default("Direct Funnel") @db.VarChar(100)
  notes                   String?                    @db.Text
  created_at              DateTime?                  @default(now()) @db.Timestamp(0)
  updated_at              DateTime?                  @default(now()) @db.Timestamp(0)
  call_logs               CallLog[]
  delivery_rescues        delivery_rescues[]
  order_items             OrderItem[]
  order_timelines         OrderTimeline[]
  packing_tasks           packing_tasks[]
  shipment_details        ShipmentDetail?

  @@index([city], map: "idx_city")
  @@index([phone_number], map: "idx_phone")
  @@index([rescue_status], map: "idx_rescue")
  @@index([status], map: "idx_status")
  @@index([created_at], map: "idx_created_at")
  @@map("order_leads")
}

model OrderItem {
  id                  String    @id @default(uuid()) @db.VarChar(36)
  order_id            String    @db.VarChar(36)
  product_id          String?   @db.VarChar(36)
  product_name        String    @db.VarChar(255)
  sku                 String    @db.VarChar(100)
  quantity            Int?      @default(1)
  price               Decimal   @db.Decimal(10, 2)
  selected_attributes String?   @db.LongText
  created_at          DateTime? @default(now()) @db.Timestamp(0)
  order_leads         OrderLead @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_order_items_order")

  @@index([order_id], map: "idx_order_id")
  @@map("order_items")
}

model ShipmentDetail {
  id                       String                   @id @default(uuid()) @db.VarChar(36)
  order_id                 String                   @unique(map: "order_id") @db.VarChar(36)
  carrier                  String?                  @default("Sendit.ma") @db.VarChar(100)
  sendit_tracking_number   String?                  @unique(map: "sendit_tracking_number") @db.VarChar(100)
  sendit_pickup_id         String?                  @db.VarChar(100)
  status                   shipment_details_status? @default(READY_FOR_PICKUP)
  waybill_url              String?                  @db.Text
  shipping_fee             Decimal?                 @default(35.00) @db.Decimal(10, 2)
  cod_amount_collected     Decimal?                 @default(0.00) @db.Decimal(10, 2)
  is_cod_reconciled        Boolean?                 @default(false)
  cod_payout_reference     String?                  @db.VarChar(100)
  failed_reason            String?                  @db.VarChar(255)
  failure_category         String?                  @db.VarChar(100)
  delivery_attempts_count  Int?                     @default(0)
  rescue_attempt_count     Int?                     @default(0)
  last_rescue_outreach_at  DateTime?                @db.Timestamp(0)
  last_status_update_at    DateTime?                @default(now()) @db.Timestamp(0)
  dispatch_notice_sent     Boolean?                 @default(false)
  dispatch_notice_sent_at  DateTime?                @db.Timestamp(0)
  morning_reminder_sent    Boolean?                 @default(false)
  morning_reminder_sent_at DateTime?                @db.Timestamp(0)
  review_prompt_sent       Boolean?                 @default(false)
  review_prompt_sent_at    DateTime?                @db.Timestamp(0)
  delivery_proof_url       String?                  @db.Text
  created_at               DateTime?                @default(now()) @db.Timestamp(0)
  updated_at               DateTime?                @default(now()) @db.Timestamp(0)
  order_leads              OrderLead                @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_shipment_order")

  @@index([status], map: "idx_ship_status")
  @@index([sendit_tracking_number], map: "idx_tracking")
  @@map("shipment_details")
}

model WhatsAppMessage {
  id                     String     @id @default(uuid()) @db.VarChar(100)
  order_id               String?    @db.VarChar(36)
  phone                  String     @db.VarChar(50)
  sender                 SenderType
  body                   String     @db.Text
  audio_transcribed_text String?    @db.Text
  audio_url              String?    @db.Text
  message_type           String?    @default("text") @db.VarChar(50)
  interactive_type       String?    @default("TEXT") @db.VarChar(50)
  button_payload         String?    @db.VarChar(100)
  quick_reply_options    String?    @db.LongText
  media_url              String?    @db.Text
  external_message_id    String?    @db.VarChar(255)
  delivery_status        String?    @default("sent") @db.VarChar(50)
  created_at             DateTime?  @default(now()) @db.Timestamp(0)

  @@index([order_id], map: "idx_msg_order")
  @@index([phone], map: "idx_msg_phone")
  @@index([created_at], map: "idx_msg_created")
  @@map("whatsapp_messages")
}

model CallLog {
  id                String     @id @default(uuid()) @db.VarChar(36)
  order_id          String     @db.VarChar(36)
  user_id           String?    @db.VarChar(36)
  result            CallResult
  call_duration_sec Int?       @default(0)
  notes             String?    @db.Text
  callback_at       DateTime?  @db.Timestamp(0)
  created_at        DateTime?  @default(now()) @db.Timestamp(0)
  order_leads       OrderLead  @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_call_order")

  @@index([order_id], map: "idx_call_order")
  @@index([result], map: "idx_call_result")
  @@map("call_logs")
}

model OrderTimeline {
  id          String    @id @default(uuid()) @db.VarChar(36)
  order_id    String    @db.VarChar(36)
  action      String    @db.VarChar(100)
  title       String    @db.VarChar(255)
  details     String?   @db.Text
  actor       String?   @default("SYSTEM") @db.VarChar(100)
  created_at  DateTime? @default(now()) @db.Timestamp(0)
  order_leads OrderLead @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_timeline_order")

  @@index([order_id], map: "idx_timeline_order")
  @@map("order_timelines")
}

model alerts {
  id         Int       @id @default(autoincrement())
  order_id   String?   @db.VarChar(36)
  tracking   String?   @db.VarChar(100)
  alert_type String?   @db.VarChar(100)
  priority   String?   @default("medium") @db.VarChar(50)
  message    String?   @db.Text
  is_read    Int?      @default(0)
  created_at DateTime? @default(now()) @db.Timestamp(0)
}

model events {
  id          Int       @id @default(autoincrement())
  order_id    String?   @db.VarChar(36)
  tracking    String?   @db.VarChar(100)
  event_type  String?   @db.VarChar(100)
  old_status  String?   @db.VarChar(100)
  new_status  String?   @db.VarChar(100)
  raw_payload String?   @db.Text
  received_at DateTime? @default(now()) @db.Timestamp(0)
  status      String?   @db.VarChar(100)
  reason      String?   @db.VarChar(255)
  note        String?   @db.Text
  timestamp   String?   @db.VarChar(50)
}

model google_sheets_sync_logs {
  id             String    @id @db.VarChar(36)
  spreadsheet_id String    @db.VarChar(255)
  sheet_name     String    @db.VarChar(100)
  rows_synced    Int?      @default(0)
  status         String?   @default("SUCCESS") @db.VarChar(50)
  details        String?   @db.Text
  created_at     DateTime? @default(now()) @db.Timestamp(0)
}

model store_settings {
  setting_key   String    @id @db.VarChar(100)
  setting_value String    @db.Text
  updated_at    DateTime? @default(now()) @db.Timestamp(0)
}

model ai_agent_configs {
  id                     String    @id @db.VarChar(36)
  agent_name             String    @default("Sarah (AI COD Specialist)") @db.VarChar(100)
  role_title             String?   @default("Spécialiste Confirmation & Vente Additionnelle") @db.VarChar(100)
  system_prompt          String    @db.Text
  tone                   String?   @default("Darija Professional & Courteous") @db.VarChar(50)
  language               String?   @default("ar-MA") @db.VarChar(50)
  auto_confirm_threshold Int?      @default(70)
  gemini_model           String?   @default("gemini-1.5-flash") @db.VarChar(100)
  is_active              Boolean?  @default(true)
  created_at             DateTime? @default(now()) @db.Timestamp(0)
  updated_at             DateTime? @default(now()) @db.Timestamp(0)
}

model customers {
  id               String                 @id @db.VarChar(36)
  phone_number     String                 @unique(map: "phone_number") @db.VarChar(50)
  name             String                 @db.VarChar(255)
  alt_phone_number String?                @db.VarChar(50)
  city             String                 @db.VarChar(100)
  address          String                 @db.Text
  total_orders     Int?                   @default(1)
  delivered_orders Int?                   @default(0)
  refused_orders   Int?                   @default(0)
  total_spent      Decimal?               @default(0.00) @db.Decimal(10, 2)
  trust_score      customers_trust_score? @default(NOUVEAU)
  notes            String?                @db.Text
  created_at       DateTime?              @default(now()) @db.Timestamp(0)
  updated_at       DateTime?              @default(now()) @db.Timestamp(0)

  @@index([city], map: "idx_cust_city")
  @@index([phone_number], map: "idx_cust_phone")
  @@index([trust_score], map: "idx_cust_trust")
}

model delivery_rescues {
  id                String                             @id @db.VarChar(36)
  order_id          String                             @db.VarChar(36)
  tracking_number   String?                            @db.VarChar(100)
  failure_reason    String                             @db.VarChar(255)
  attempt_number    Int?                               @default(1)
  outreach_channel  delivery_rescues_outreach_channel? @default(WHATSAPP)
  outreach_status   delivery_rescues_outreach_status?  @default(PENDING)
  new_delivery_date DateTime?                          @db.Date
  new_address       String?                            @db.Text
  resolution_notes  String?                            @db.Text
  resolved_at       DateTime?                          @db.Timestamp(0)
  created_at        DateTime?                          @default(now()) @db.Timestamp(0)
  updated_at        DateTime?                          @default(now()) @db.Timestamp(0)
  order_leads       OrderLead                          @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_rescue_order")

  @@index([order_id], map: "idx_rescue_order")
}

model finance_transactions {
  id               String                                 @id @db.VarChar(36)
  reference        String                                 @unique(map: "reference") @db.VarChar(100)
  transaction_type finance_transactions_transaction_type? @default(COD_REMITTANCE)
  amount           Decimal                                @db.Decimal(10, 2)
  carrier          String?                                @default("Sendit.ma") @db.VarChar(100)
  order_count      Int?                                   @default(0)
  period_start     DateTime?                              @db.Date
  period_end       DateTime?                              @db.Date
  status           finance_transactions_status?           @default(PENDING)
  bank_account     String?                                @db.VarChar(255)
  receipt_url      String?                                @db.Text
  created_at       DateTime?                              @default(now()) @db.Timestamp(0)

  @@index([reference], map: "idx_fin_ref")
  @@index([status], map: "idx_fin_status")
}

model notifications {
  id         Int                     @id @default(autoincrement())
  title      String                  @db.VarChar(255)
  message    String                  @db.Text
  type       notifications_type?     @default(ORDER)
  priority   notifications_priority? @default(MEDIUM)
  link_url   String?                 @db.VarChar(255)
  is_read    Boolean?                @default(false)
  created_at DateTime?               @default(now()) @db.Timestamp(0)

  @@index([created_at], map: "idx_notif_created")
  @@index([is_read], map: "idx_notif_unread")
}

model packing_tasks {
  id              String                @id @db.VarChar(36)
  order_id        String                @db.VarChar(36)
  packer_id       String?               @db.VarChar(36)
  box_type        String?               @default("Standard Carton") @db.VarChar(50)
  barcode_scanned String?               @db.VarChar(100)
  items_verified  Boolean?              @default(true)
  notes           String?               @db.Text
  status          packing_tasks_status? @default(PENDING)
  packed_at       DateTime?             @db.Timestamp(0)
  created_at      DateTime?             @default(now()) @db.Timestamp(0)
  updated_at      DateTime?             @default(now()) @db.Timestamp(0)
  order_leads     OrderLead             @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_pack_order")

  @@index([order_id], map: "idx_pack_order")
  @@index([status], map: "idx_pack_status")
}

model product_variants {
  id             String    @id @db.VarChar(36)
  product_id     String    @db.VarChar(36)
  title          String    @db.VarChar(255)
  sku            String    @unique(map: "sku") @db.VarChar(100)
  attributes     String?   @db.LongText
  price_extra    Decimal?  @default(0.00) @db.Decimal(10, 2)
  stock_quantity Int?      @default(0)
  barcode        String?   @db.VarChar(100)
  is_active      Boolean?  @default(true)
  created_at     DateTime? @default(now()) @db.Timestamp(0)
  updated_at     DateTime? @default(now()) @db.Timestamp(0)
  products       Product   @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_var_product")

  @@index([product_id], map: "idx_var_prod")
  @@index([sku], map: "idx_var_sku")
}

model realtime_events {
  id           Int       @id @default(autoincrement())
  event_type   String    @db.VarChar(100)
  entity_type  String    @db.VarChar(50)
  entity_id    String    @db.VarChar(100)
  title        String    @db.VarChar(255)
  payload      String?   @db.LongText
  source       String?   @default("SYSTEM") @db.VarChar(100)
  is_broadcast Boolean?  @default(true)
  created_at   DateTime? @default(now()) @db.Timestamp(0)

  @@index([created_at], map: "idx_evt_created")
  @@index([entity_type, entity_id], map: "idx_evt_entity")
  @@index([event_type], map: "idx_evt_type")
}

model stock_movements {
  id             String               @id @db.VarChar(36)
  product_id     String               @db.VarChar(36)
  sku            String               @db.VarChar(100)
  type           stock_movements_type
  quantity       Int
  previous_stock Int
  new_stock      Int
  reason         String?              @db.VarChar(255)
  order_id       String?              @db.VarChar(36)
  created_by     String?              @default("SYSTEM") @db.VarChar(100)
  created_at     DateTime?            @default(now()) @db.Timestamp(0)
  products       Product              @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_stock_prod")

  @@index([product_id], map: "idx_stock_prod")
  @@index([type], map: "idx_stock_type")
}

model whatsapp_instances {
  id                String                     @id @db.VarChar(100)
  instance_name     String                     @db.VarChar(100)
  phone_number      String?                    @db.VarChar(50)
  status            whatsapp_instances_status? @default(DISCONNECTED)
  qr_code           String?                    @db.Text
  battery_level     Int?                       @default(100)
  last_connected_at DateTime?                  @db.Timestamp(0)
  created_at        DateTime?                  @default(now()) @db.Timestamp(0)
  updated_at        DateTime?                  @default(now()) @db.Timestamp(0)
}

enum CallResult {
  NO_ANSWER_1
  NO_ANSWER_2
  OUT_OF_COVERAGE
  CALLBACK_REQUESTED
  BUSY
  CONFIRMED_MANUALLY
  CANCELED_BY_CLIENT
}

enum SenderType {
  CUSTOMER
  AI_BOT
  AGENT
}

enum shipment_details_status {
  READY_FOR_PICKUP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED_PAID
  DELIVERY_FAILED
  RETURNED
}

enum order_leads_status {
  NEW
  AI_CHATTING
  CONFIRMED
  PACKING
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED_PAID
  DELIVERY_FAILED
  CANCELED
  DUPLICATE
}

enum order_leads_risk_level {
  LOW
  MEDIUM
  HIGH
  BLACK_LISTED
}

enum order_leads_rescue_status {
  NONE
  NEEDS_ATTENTION
  OUTREACH_SENT
  RESCHEDULED
  ADDRESS_UPDATED
  ESCALATED
  RETURN_CONFIRMED
}

enum finance_transactions_transaction_type {
  COD_REMITTANCE
  SHIPPING_FEE_DEDUCTION
  RETURN_PENALTY
  BANK_PAYOUT
}

enum notifications_type {
  ORDER
  DELIVERY_FAILED
  SLA_BREACH
  OUT_OF_STOCK
  WHATSAPP_HANDOVER
  SYSTEM
}

enum stock_movements_type {
  IN
  OUT
  RETURN
  DAMAGE
  ADJUSTMENT
}

enum whatsapp_instances_status {
  CONNECTING
  CONNECTED
  DISCONNECTED
  QR_READY
}

enum notifications_priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum users_role {
  ADMIN
  CONFIRMATION_AGENT
  PACKER
  TRACKING_AGENT
  CALL_AGENT
}

enum delivery_rescues_outreach_channel {
  WHATSAPP
  CALL
  SMS
}

enum delivery_rescues_outreach_status {
  PENDING
  SENT
  RESPONDED
  RESOLVED
  ABANDONED
}

enum packing_tasks_status {
  PENDING
  PACKING
  PACKED
  DISPATCHED
}

enum finance_transactions_status {
  PENDING
  PROCESSED
  RECONCILED
  DISPUTED
}

enum customers_trust_score {
  VIP
  FIABLE
  NOUVEAU
  RISQUE
  BLACKLIST
}
